<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
  <id>com.forge.bpmn</id>
  <name>Forge BPMN</name>
  <version>0.4.0</version>
  <vendor url="https://github.com/kennethIve/forge-bpmn-intellij">Forge</vendor>

  <description><![CDATA[
    <p><b>Forge BPMN</b> opens <code>.bpmn</code> files in a Camunda Modeler–style editor inside IntelliJ IDEA.</p>
    <ul>
      <li>Diagram canvas + properties panel (bpmn-js Cloud)</li>
      <li>BPMN ↔ XML tabs with round-trip sync</li>
      <li>Token Simulation with quiet New UI gray chips</li>
      <li>Light and Dark theme sync with the IDE</li>
      <li>BPMN Explorer tool window</li>
    </ul>
  ]]></description>

  <change-notes><![CDATA[
    <ul>
      <li>Built with Java 25 against IntelliJ IDEA 2026.2.</li>
      <li>Native BPMN / XML editor tabs, with round-trip sync.</li>
      <li>Camunda Modeler-style diagram editor, properties panel, and BPMN syntax lint.</li>
    </ul>
  ]]></change-notes>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lang</depends>
  <depends>com.intellij.modules.xml</depends>
  <depends>com.intellij.modules.jcef</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="BPMN"
              implementationClass="com.forge.bpmn.BpmnFileType"
              fieldName="INSTANCE"
              language="XML"
              extensions="bpmn"/>
    <fileEditorProvider implementation="com.forge.bpmn.BpmnFileEditorProvider"/>
    <fileEditorProvider implementation="com.forge.bpmn.BpmnXmlEditorProvider"/>
    <toolWindow id="BPMN"
                anchor="left"
                secondary="false"
                canCloseContents="false"
                icon="/META-INF/bpmnFileIcon.svg"
                factoryClass="com.forge.bpmn.BpmnToolWindowFactory"/>
    <annotator language="XML" implementationClass="com.forge.bpmn.BpmnAnnotator"/>
    <localInspection language="XML"
                     shortName="BpmnSyntax"
                     displayName="BPMN syntax"
                     groupName="BPMN"
                     enabledByDefault="true"
                     level="ERROR"
                     implementationClass="com.forge.bpmn.BpmnInspection"/>
  </extensions>

  <actions>
    <action id="com.forge.bpmn.ActivateToolWindow"
            class="com.forge.bpmn.ActivateBpmnToolWindowAction"
            text="BPMN"
            description="Show the BPMN files tool window"
            icon="/META-INF/bpmnFileIcon.svg">
      <add-to-group group-id="ToolWindowsGroup" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
